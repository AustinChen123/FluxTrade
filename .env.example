POSTGRES_USER=fluxtrade
POSTGRES_PASSWORD=fluxtrade_password
POSTGRES_DB=fluxtrade
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
# Redis auth (leave empty for no password in local dev)
REDIS_PASSWORD=
FLUXTRADE_ENVIRONMENT=local

HOT_STRATEGIES_PATH=/app/strategies_hot

# Strategy execution. Local development defaults to simulated; production
# Compose requires ADAPTER_MODE and AUDIT_EXTERNAL_ORDERS explicitly.
ADAPTER_MODE=simulated
AUDIT_EXTERNAL_ORDERS=false
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
EXCHANGE_TESTNET=true
EXCHANGE_ENABLE_WS=false
INSTRUMENT_PRODUCT_IDS=BINANCE:BTCUSDT-PERP
ACCOUNT_POSITION_MODE=one_way
ACCOUNT_LEVERAGE=
ACCOUNT_MARGIN_MODE=

# Market-data runtime. Production Compose requires both values explicitly.
EXCHANGE_ENABLED=binance
MARKET_DATA_SYMBOLS=BTCUSDT
PUBLISHER_CHANNEL_CAPACITY=10000
BINANCE_API_KEY=
BINANCE_SECRET=

# Rithmic runtime. Required only when the selected execution or data venue is
# Rithmic. Keep the credentials file outside the repository.
RITHMIC_PROFILE=
RITHMIC_RECOVERY_PROFILE=
RITHMIC_ACCOUNT_ID=
RITHMIC_PRODUCT_ID=
RITHMIC_EXCHANGE=
RITHMIC_SYMBOL=
RITHMIC_INSTRUMENTS_JSON=
FLUXTRADE_CREDENTIALS_PATH=
FLUXTRADE_SECRETS_DIR=

# Dashboard auth (leave empty to disable login)
DASHBOARD_PASSWORD=

# Control-plane auth (leave empty to allow unauthenticated local API access)
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8080
CONTROL_PLANE_JOB_DB_PATH=
# Enable only behind a trusted Tailscale Serve proxy on the localhost-published port.
CONTROL_PLANE_TRUSTED_PROXY_AUTH=false
CONTROL_PLANE_BROWSER_ORIGIN=
CONTROL_PLANE_OPERATOR_CAPABILITY=
CONTROL_PLANE_STEP_UP_CAPABILITY=
CONTROL_PLANE_SESSION_TTL_SECONDS=28800
CONTROL_PLANE_STEP_UP_TTL_SECONDS=300

# Localhost-only operator endpoints in production Compose.
DASHBOARD_PORT=8501
GRAFANA_PORT=3000
GRAFANA_PASSWORD=

# Service resource defaults.
RUST_DATA_IMAGE=fluxtrade-rust-data:local
PYTHON_STRATEGY_IMAGE=fluxtrade-python-strategy:local
CONTROL_PLANE_MEMORY_LIMIT=512M
CONTROL_PLANE_CPU_LIMIT=0.5
METRICS_ENABLED=true
METRICS_PORT=9090
LOG_FORMAT=json

# Risk Management Configuration
RISK_MAX_SINGLE_ORDER_NOTIONAL_PCT=0.05          # Decimal fraction: 0.05 = 5% of NAV per order
RISK_DAILY_LOSS_CIRCUIT_BREAKER_PCT=0.05        # Decimal fraction: 0.05 = 5% daily NAV loss
RISK_MAX_ORDERS_PER_MINUTE=10                   # Max accepted entry orders per strategy per rolling minute
RISK_MAX_PRICE_DEVIATION_FROM_MID_PCT=0.03      # Decimal fraction: 0.03 = 3% from bid/ask mid
RISK_MAX_POSITION_NOTIONAL=100000               # Max projected position notional in USDT
# Set true only for DCA/grid strategies that intentionally scale into positions.
RISK_ALLOW_SAME_SIDE_REENTRY=false

# Runtime reconciliation interval in seconds.
RUNTIME_RECONCILE_INTERVAL_SECONDS=3600
# Quantity drift threshold before runtime reconciliation writes an event.
RECONCILE_QTY_DRIFT_THRESHOLD=0.00000001
# Balance drift threshold before runtime reconciliation writes an event.
RECONCILE_BALANCE_DRIFT_THRESHOLD=0.01
